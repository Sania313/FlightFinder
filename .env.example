# Used by the local proxy (server/proxy.mjs). Stays server-side — preferred.
SERPAPI_KEY=your_serpapi_key_here

# Optional: direct calls from native builds (bundled into the client).
# Leave empty to always route through the proxy.
EXPO_PUBLIC_SERPAPI_KEY=

# Where the app should reach the proxy. Defaults to http://localhost:8787/api
EXPO_PUBLIC_API_PROXY_URL=http://localhost:8787/api
